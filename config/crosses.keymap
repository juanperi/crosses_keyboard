#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define BASE 0
#define NAV 1
#define NUM 2
#define SYM 3
#define FUN 4
#define SYS 5

/* The exact UHK labels are not present in the JSON export, so these use the
 * standard macOS equivalents for the confirmed user-facing actions. */
/ {
    chosen { zmk,physical-layout = &gggw_crosses_42_layout; };

    combos {
        compatible = "zmk,combos";
        sys_combo {
            timeout-ms = <80>;
            key-positions = <36 41>;
            layers = <BASE>;
            bindings = <&mo SYS>;
        };
    };

    behaviors {
        win_tabs_left: win_tabs_left {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_press &kp LCTRL>, <&macro_tap &kp TAB>, <&macro_release &kp LCTRL>;
        };
        win_tabs_right: win_tabs_right {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_press &kp LCTRL>, <&macro_press &kp LSHFT>, <&macro_tap &kp TAB>, <&macro_release &kp LSHFT>, <&macro_release &kp LCTRL>;
        };
        win_mission_control: win_mission_control {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_press &kp LCTRL>, <&macro_tap &kp UP>, <&macro_release &kp LCTRL>;
        };
        win_space_left: win_space_left {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_press &kp LCTRL>, <&macro_press &kp LALT>, <&macro_tap &kp LEFT>, <&macro_release &kp LALT>, <&macro_release &kp LCTRL>;
        };
        win_space_right: win_space_right {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_press &kp LCTRL>, <&macro_press &kp LALT>, <&macro_tap &kp RIGHT>, <&macro_release &kp LALT>, <&macro_release &kp LCTRL>;
        };
        win_alt_tab: win_alt_tab {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_press &kp LALT>, <&macro_tap &kp TAB>, <&macro_release &kp LALT>;
        };
        win_slack_previous: win_slack_previous {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_press &kp LGUI>, <&macro_tap &kp LBKT>, <&macro_release &kp LGUI>;
        };
        win_slack_next: win_slack_next {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_press &kp LGUI>, <&macro_tap &kp RBKT>, <&macro_release &kp LGUI>;
        };
        screenshot: screenshot {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_press &kp LGUI>, <&macro_press &kp LCTRL>, <&macro_press &kp LSHFT>, <&macro_tap &kp N4>, <&macro_release &kp LSHFT>, <&macro_release &kp LCTRL>, <&macro_release &kp LGUI>;
        };
        hml: homerow_mods_left {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            flavor = "balanced";
            hold-trigger-key-positions = <6 7 8 9 10 11 18 19 20 21 22 23 30 31 32 33 34 35 39 40 41>;
            hold-trigger-on-release;
            bindings = <&kp>, <&kp>;
        };
        hmr: homerow_mods_right {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            flavor = "balanced";
            hold-trigger-key-positions = <0 1 2 3 4 5 12 13 14 15 16 17 24 25 26 27 28 29 36 37 38>;
            hold-trigger-on-release;
            bindings = <&kp>, <&kp>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base_layer {
            display-name = "Base";
            bindings = <
                &kp TAB   &kp Q        &kp W        &kp E        &kp R        &kp T        &kp Y        &kp U        &kp I        &kp O        &kp P        &kp BSPC
                &kp LCTRL          &hml LCTRL A  &hml LALT S    &hml LSHFT D  &hml LGUI F  &kp G        &kp H        &hmr RGUI J    &hmr RSHFT K   &hmr RALT L   &hmr RCTRL SEMI &kp SQT
                &kp LSHFT &kp Z        &kp X        &kp C        &kp V        &kp B        &kp N        &kp M        &kp COMMA   &kp DOT      &kp FSLH    &kp ESC
                                       &mo NUM        &lt NAV LGUI  &kp SPACE        &kp RET      &kp SPACE      &lt SYM BSPC
            >;
        };

        nav_layer {
            display-name = "Nav";
            bindings = <
                &trans &trans &win_tabs_left &win_mission_control &win_tabs_right &trans       &kp PG_UP &kp HOME &kp UP   &kp END  &kp PG_DN &screenshot
                &trans &trans &win_space_left &win_alt_tab &win_space_right &trans       &kp LEFT  &kp DOWN &kp UP   &kp RIGHT &kp DEL &trans
                &trans &kp K_UNDO &win_slack_previous &trans &win_slack_next &kp K_REDO &kp INS &kp TAB &kp PG_DN &kp PG_UP &kp END &trans
                                       &trans &trans &trans &trans &trans &mo FUN
            >;
        };

        num_layer {
            display-name = "Num";
            bindings = <
                &trans &trans &trans &trans &trans &trans       &kp PLUS &kp N7 &kp N8 &kp N9 &kp MINUS &trans
                &trans &trans &mkp RCLK &mkp MCLK &mkp LCLK &trans       &kp ASTERISK &kp N4 &kp N5 &kp N6 &kp FSLH &trans
                &trans &trans &trans &trans &trans &trans       &kp COMMA &kp N1 &kp N2 &kp N3 &kp DOT &kp EQUAL
                                       &trans &trans &kp N0 &trans &trans &trans
            >;
        };

        sym_layer {
            display-name = "Sym";
            bindings = <
                &trans &kp EXCL &kp AT &kp HASH &kp DLLR &kp PRCNT       &kp CARET &kp AMPS &kp ASTERISK &kp LPAR &kp RPAR &trans
                &trans &trans &trans &trans &trans &trans       &kp MINUS &kp EQUAL &kp LBKT &kp RBKT &kp BSLH &kp GRAVE
                &trans &trans &trans &trans &trans &trans       &kp COLON &kp DQT &kp LT &kp GT &kp QMARK &trans
                                       &trans &trans &trans &trans &trans &trans
            >;
        };

        fun_layer {
            display-name = "Fun";
            bindings = <
                &kp C_MUTE &kp C_VOL_DN &kp C_VOL_UP &kp C_PREV &kp C_PP &kp C_NEXT       &kp F7 &kp F8 &kp F9 &kp F10 &kp F11 &kp F12
                &trans &trans &trans &trans &trans &trans       &kp F4 &kp F5 &kp F6 &trans &trans &trans
                &trans &trans &trans &trans &trans &trans       &kp F1 &kp F2 &kp F3 &trans &trans &trans
                                       &mo SYS &trans &trans &trans &trans &trans
            >;
        };

        sys_layer {
            display-name = "Sys";
            bindings = <
                &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4 &bt BT_CLR       &trans &trans &trans &trans &trans &trans
                &bootloader &sys_reset &trans &trans &trans &trans       &trans &trans &trans &trans &trans &bootloader
                &trans &trans &trans &trans &trans &trans       &trans &trans &trans &trans &trans &trans
                                       &trans &trans &trans &trans &trans &trans
            >;
        };
    };
};
