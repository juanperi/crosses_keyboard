#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
#include "scroll-invert.dtsi"

#define BASE 0
#define NAV 1
#define NUMSYM 2
#define FUN 3
#define SYS 4

/* The exact UHK labels are not present in the JSON export, so these use the
 * standard macOS equivalents for the confirmed user-facing actions. */
/ {
    chosen { zmk,physical-layout = &gggw_crosses_42_layout; };

    combos {
        compatible = "zmk,combos";
        sys_combo {
            timeout-ms = <80>;
            key-positions = <38 41>;
            layers = <BASE>;
            bindings = <&mo SYS>;
        };
        escape_combo {
            timeout-ms = <35>;
            require-prior-idle-ms = <100>;
            key-positions = <3 4>;
            layers = <BASE>;
            bindings = <&kp ESC>;
        };
        enter_combo {
            timeout-ms = <35>;
            require-prior-idle-ms = <100>;
            key-positions = <15 16>;
            layers = <BASE>;
            slow-release;
            bindings = <&combo_mods &cmd_shift RET>;
        };
        enter_combo_jk {
            timeout-ms = <35>;
            require-prior-idle-ms = <100>;
            key-positions = <19 20>;
            layers = <BASE>;
            slow-release;
            bindings = <&combo_mods &cmd_shift RET>;
        };
        tab_combo {
            timeout-ms = <35>;
            require-prior-idle-ms = <100>;
            key-positions = <14 15>;
            layers = <BASE>;
            bindings = <&kp TAB>;
        };
        parentheses_combo {
            timeout-ms = <35>;
            require-prior-idle-ms = <100>;
            key-positions = <5 6>;
            layers = <BASE>;
            bindings = <&parentheses_macro>;
        };
    };

    behaviors {
        combo_mods: combo_mods {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <280>;
            bindings = <&cmd_shift>, <&kp>;
        };

        cmd_shift: cmd_shift {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_press &kp LGUI>, <&macro_press &kp LSHFT>, <&macro_pause_for_release>, <&macro_release &kp LSHFT>, <&macro_release &kp LGUI>;
        };

        win_tabs_left: win_tabs_left {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_press &kp LCTRL>, <&macro_tap &kp TAB>, <&macro_release &kp LCTRL>;
        };
        win_tabs_right: win_tabs_right {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_press &kp LCTRL>, <&macro_press &kp LSHFT>, <&macro_tap &kp TAB>, <&macro_release &kp LSHFT>, <&macro_release &kp LCTRL>;
        };
        win_mission_control: win_mission_control {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_press &kp LCTRL>, <&macro_tap &kp UP>, <&macro_release &kp LCTRL>;
        };
        win_space_left: win_space_left {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_press &kp LCTRL>, <&macro_press &kp LALT>, <&macro_tap &kp LEFT>, <&macro_release &kp LALT>, <&macro_release &kp LCTRL>;
        };
        win_space_right: win_space_right {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_press &kp LCTRL>, <&macro_press &kp LALT>, <&macro_tap &kp RIGHT>, <&macro_release &kp LALT>, <&macro_release &kp LCTRL>;
        };
        win_slack_previous: win_slack_previous {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_press &kp LGUI>, <&macro_tap &kp LBKT>, <&macro_release &kp LGUI>;
        };
        win_slack_next: win_slack_next {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_press &kp LGUI>, <&macro_tap &kp RBKT>, <&macro_release &kp LGUI>;
        };
        screenshot: screenshot {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_press &kp LGUI>, <&macro_press &kp LCTRL>, <&macro_press &kp LSHFT>, <&macro_tap &kp N4>, <&macro_release &kp LSHFT>, <&macro_release &kp LCTRL>, <&macro_release &kp LGUI>;
        };
        parentheses_macro: parentheses_macro {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_tap &kp LPAR>, <&macro_tap &kp RPAR>, <&macro_tap &kp LEFT>;
        };
        hml: homerow_mods_left {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            flavor = "balanced";
            hold-trigger-key-positions = <6 7 8 9 10 11 18 19 20 21 22 23 30 31 32 33 34 35 39 40 41>;
            hold-trigger-on-release;
            bindings = <&kp>, <&kp>;
        };
        hmr: homerow_mods_right {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            flavor = "balanced";
            hold-trigger-key-positions = <0 1 2 3 4 5 12 13 14 15 16 17 24 25 26 27 28 29 36 37 38>;
            hold-trigger-on-release;
            bindings = <&kp>, <&kp>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base_layer {
            display-name = "Base";
            bindings = <
                &kp ESC   &kp Q        &kp W        &kp E        &kp R        &kp T        &kp Y        &kp U        &kp I        &kp O        &kp P        &kp BSPC
                &kp TAB             &hml LCTRL A  &hml LALT S    &hml LSHFT D  &hml LGUI F  &kp G        &kp H        &hmr RGUI J    &hmr RSHFT K   &hmr RALT L   &hmr RCTRL SEMI &kp SQT
                &trans    &kp Z        &kp X        &kp C        &kp V        &kp B        &kp N        &kp M        &kp COMMA   &kp DOT      &kp FSLH    &trans
                                       &kp LGUI       &mo NAV        &mo NUMSYM     &trans        &kp SPACE      &lt FUN BSPC
            >;
        };

        nav_layer {
            display-name = "Nav";
            bindings = <
                &trans &trans &win_tabs_left &win_mission_control &win_tabs_right &mkp RCLK       &kp HOME  &kp PG_DN &kp PG_UP &kp END  &trans     &trans
                &trans &trans &win_space_left &trans &win_space_right &mkp LCLK       &kp LEFT  &kp DOWN &kp UP   &kp RIGHT &trans   &trans
                &screenshot &trans &win_slack_previous &trans &win_slack_next &trans &kp INS &kp TAB &kp DEL   &trans     &trans    &trans
                                       &trans &trans &trans &trans &trans &mo FUN
            >;
        };

        numsym_layer {
            display-name = "Num/Sym";
            bindings = <
                &trans &kp EXCL &kp AT &kp HASH &kp DLLR &kp PRCNT       &kp PLUS &kp N7 &kp N8 &kp N9 &kp ASTERISK &kp LBKT
                &trans    &kp CARET &kp AMPS &kp LPAR &kp RPAR &kp GRAVE       &kp MINUS &kp N4 &kp N5 &kp N6 &kp FSLH &kp RBKT
                &trans &kp COLON &kp BSLH &kp LT &kp GT &kp UNDER        &kp N0 &kp N1 &kp N2 &kp N3 &kp DOT &kp EQUAL
                &trans &trans &trans &trans &trans &trans
            >;
        };

        fun_layer {
            display-name = "Fun";
            bindings = <
                &kp C_MUTE &kp C_VOL_DN &kp C_VOL_UP &kp C_PREV &kp C_PP &kp C_NEXT       &kp F7 &kp F8 &kp F9 &kp F10 &kp F11 &kp F12
                &trans &trans &trans &trans &trans &trans       &kp F4 &kp F5 &kp F6 &trans &trans &trans
                &trans &trans &trans &trans &trans &trans       &kp F1 &kp F2 &kp F3 &trans &trans &trans
                                       &mo SYS &trans &trans &trans &trans &trans
            >;
        };

        sys_layer {
            display-name = "Sys";
            bindings = <
                &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4 &bt BT_CLR       &trans &trans &trans &trans &trans &studio_unlock
                &bootloader &sys_reset &trans &trans &trans &trans       &trans &trans &trans &trans &trans &bootloader
                &trans &trans &trans &trans &trans &trans       &trans &trans &trans &trans &trans &trans
                                       &trans &trans &trans &trans &trans &trans
            >;
        };
    };
};
